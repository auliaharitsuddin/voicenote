# Required: shared secret the app sends as "Authorization: Bearer ..." (>= 24 chars)
APP_TOKEN=
# Groq (Whisper STT + chat model)
GROQ_API_KEY=
# GROQ_CHAT_MODEL=openai/gpt-oss-120b
# GROQ_STT_MODEL=whisper-large-v3-turbo
# Email reading via IMAP over TLS (use an app password, e.g. Gmail "App passwords"; never your real password)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_POLL_MIN=5
IMAP_LOOKBACK_DAYS=3
TZ=Asia/Jakarta
# Web origins allowed to call this API (Expo web dev server by default)
ALLOWED_ORIGINS=http://localhost:8081
PORT=5010
